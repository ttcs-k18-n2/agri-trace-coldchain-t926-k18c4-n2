POSTGRES_DB=agri_trace
POSTGRES_USER=agri_migration
POSTGRES_PASSWORD=migration_password
APP_DB_USER=agri_app
APP_DB_PASSWORD=app_password
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=8080
DATABASE_URL=postgresql://agri_app:app_password@postgres:5432/agri_trace
MIGRATION_DATABASE_URL=postgresql://agri_migration:migration_password@postgres:5432/agri_trace
SESSION_SECRET=agri_trace_random_session_secret_key_32_characters_minimum
# Set COOKIE_SECURE=true for staging and production (requires HTTPS / reverse proxy)
COOKIE_SECURE=true

# S-24: Thoi gian nguong danh dau ban giao qua han chua xac nhan (gio)
TRANSFER_OVERDUE_HOURS=48
